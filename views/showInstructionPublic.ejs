<div class="container instructionPublicPage">

    <div class="instrNav">
        <a href="javascript:history.back()" class="instrBackLink">← Назад</a>
    </div>

    <div class="pageTitle">
        <h2>Инструкция № <%= instruction.number %></h2>
        <% if (instruction.title) { %>
            <p><%= instruction.title %></p>
        <% } %>
    </div>

    <% if (instruction.description) { %>
        <div class="instrDescCard">
            <span class="instrDescLabel">Вид опасност</span>
            <p class="instrDescText"><%= instruction.description %></p>
        </div>
    <% } %>

    <div class="instrContentCard">
        <%- include("./partials/content.ejs") %>
    </div>

</div>

<script>
    const encodedContent = '<%- instruction.content %>';
    const decodedContent = decodeURIComponent(atob(encodedContent));
    document.getElementById('content').innerHTML = decodedContent;
</script>
