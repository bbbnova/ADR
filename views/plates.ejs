<div class="container platesPage">

    <div class="pageTitle">
        <h2>Табели за опасност</h2>
        <p>Изберете табела(и) за да видите общите кодове на опасност и приложимите инструкции</p>
    </div>

    <div class="platesFilterBox">
        <div class="platesFilterHeader">
            <span class="platesFilterLabel">Филтър по табели</span>
            <button id="clearPlateSelection" type="button" class="platesClearBtn hidden">Изчисти избор</button>
        </div>
        <div class="platesFilterOptions" id="platesFilterOptions">
            <% if (plates && plates.length > 0) { %>
                <% plates.forEach((plate) => { %>
                    <label class="plateOptionItem">
                        <input type="checkbox" class="plateFilterCheck" value="<%= plate.image %>">
                        <img src="/img/plates/<%= plate.image %>" alt="Табела <%= plate.image %>">
                        <span><%= plate.image %></span>
                    </label>
                <% }) %>
            <% } %>
        </div>
    </div>

    <div class="platesResultCard hidden" id="platesResultCard">
        <div class="platesResultHeader">Съвпадения за избраните табели</div>
        <div class="platesSelectedRow" id="platesSelectedRow"></div>
        <div class="platesResultDetails">
            <div class="platesResultRow">
                <span class="platesResultLabel">Инструкция:</span>
                <span id="filteredInstructions" class="plateInstructionLinks"></span>
            </div>
            <div class="platesResultRow">
                <span class="platesResultLabel">Вид опасност:</span>
                <span id="filteredDangerCodes" class="plateDangerCodes"></span>
            </div>
        </div>
    </div>
    <p id="platesNoResults" class="plateNoData hidden">Няма общи кодове/инструкции за избраните табели.</p>

    <div class="platesSectionTitle">Всички налични табели</div>
    <div class="platesList" id="allPlatesList"></div>
</div>

<script>
    window.addEventListener('DOMContentLoaded', async () => {

        // Load the static plate→instruction mapping
        let plateMap;
        try {
            const resp = await fetch('/modules/plateInstructions.json');
            plateMap = await resp.json();
        } catch (e) {
            console.error('Не може да се зареди plateInstructions.json', e);
            return;
        }

        const checks        = Array.from(document.querySelectorAll('.plateFilterCheck'));
        const clearButton   = document.querySelector('#clearPlateSelection');
        const noResults     = document.querySelector('#platesNoResults');
        const selectedRow   = document.querySelector('#platesSelectedRow');
        const dangerEl      = document.querySelector('#filteredDangerCodes');
        const instructionEl = document.querySelector('#filteredInstructions');
        const resultCard    = document.querySelector('#platesResultCard');

        if (!checks.length || !selectedRow || !dangerEl || !instructionEl || !resultCard) return;

        // Find the best matching instruction(s) for the selected plates
        const resolveInstructions = (selected) => {
            if (selected.length === 0) return [];

            if (selected.length === 1) {
                const num = plateMap.singlePlate[selected[0]];
                return num && plateMap.instructions[num] ? [plateMap.instructions[num]] : [];
            }

            // Find all combination rules where every listed plate is selected
            const selSet = new Set(selected);
            const matched = (plateMap.combinations || [])
                .filter(c => c.plates.every(p => selSet.has(p)))
                .sort((a, b) => b.plates.length - a.plates.length);   // most specific first

            if (matched.length > 0) {
                const num = matched[0].instruction;
                return num && plateMap.instructions[num] ? [plateMap.instructions[num]] : [];
            }

            // Fallback: deduplicated union of individual instructions
            const seen = new Set();
            return selected.reduce((acc, plate) => {
                const num = plateMap.singlePlate[plate];
                if (num && plateMap.instructions[num] && !seen.has(num)) {
                    seen.add(num);
                    acc.push(plateMap.instructions[num]);
                }
                return acc;
            }, []);
        };

        const renderSelectedPlates = (selected) => {
            selectedRow.innerHTML = '';
            selected.forEach(plate => {
                const item = document.createElement('div');
                item.className = 'plateSelectedItem';
                item.innerHTML = `<img src="/img/plates/${plate}" alt="Табела ${plate}" class="platePreviewImage">
                    <div class="plateFileName">${plate}</div>`;
                selectedRow.appendChild(item);
            });
        };

        const renderInstructionLinks = (instructions) => {
            instructionEl.innerHTML = '';
            instructions.forEach((instr, i) => {
                const a = document.createElement('a');
                a.href = `/instruction/${instr.id}`;
                a.textContent = instr.number;
                a.title = instr.description || '';
                instructionEl.appendChild(a);
                if (i < instructions.length - 1) instructionEl.appendChild(document.createTextNode(', '));
            });
        };

        const applyFilter = () => {
            const selected = checks.filter(ch => ch.checked).map(ch => ch.value);

            if (selected.length === 0) {
                resultCard.classList.add('hidden');
                if (noResults)    noResults.classList.add('hidden');
                if (clearButton)  clearButton.classList.add('hidden');
                return;
            }

            renderSelectedPlates(selected);

            const instructions = resolveInstructions(selected);

            if (instructions.length > 0) {
                renderInstructionLinks(instructions);
                dangerEl.textContent = instructions.map(i => i.description).join(' / ');
                if (noResults) noResults.classList.add('hidden');
            } else {
                instructionEl.textContent = 'Няма данни.';
                dangerEl.textContent = '';
                if (noResults) noResults.classList.remove('hidden');
            }

            resultCard.classList.remove('hidden');
            if (clearButton) clearButton.classList.remove('hidden');
        };

        checks.forEach(ch => ch.addEventListener('change', applyFilter));

        if (clearButton) {
            clearButton.addEventListener('click', () => {
                checks.forEach(ch => { ch.checked = false; });
                applyFilter();
            });
        }

        applyFilter();

        // Render all plates list with correct instruction data from JSON
        const allPlatesList = document.querySelector('#allPlatesList');
        if (allPlatesList) {
            checks.forEach(ch => {
                const plate = ch.value;
                const instrNum = plateMap.singlePlate[plate];
                const instr = instrNum ? plateMap.instructions[instrNum] : null;

                const item = document.createElement('div');
                item.className = 'plateItem';

                const instrHTML = instr
                    ? `<a href="/instruction/${instr.id}" title="${instr.description}">${instr.number}</a>`
                    : '<span class="plateNoData">Няма свързана инструкция.</span>';
                const descHTML = instr
                    ? `<span class="plateDangerCodes">${instr.description}</span>`
                    : '';

                item.innerHTML = `
                    <div class="plateImageWrap">
                        <img src="/img/plates/${plate}" alt="Табела ${plate}" class="platePreviewImage">
                        <div class="plateFileName">${plate}</div>
                    </div>
                    <div class="plateDetails">
                        <div class="plateDetailRow">
                            <span class="plateDetailLabel">Инструкция:</span>
                            <span class="plateInstructionLinks">${instrHTML}</span>
                        </div>
                        <div class="plateDetailRow">
                            <span class="plateDetailLabel">Вид опасност:</span>
                            ${descHTML}
                        </div>
                    </div>`;
                allPlatesList.appendChild(item);
            });
        }
    });
</script>

