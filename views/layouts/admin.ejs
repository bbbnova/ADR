<!DOCTYPE html>
<html lang="bg">
<head>
    <title><%= typeof title !== 'undefined' ? title : 'ADR Опасни товари' %></title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/ckeditor/ckeditor5/ckeditor5.css">
    <link rel="icon" type="image/png" href="/img/logo.png">
</head>
<body>
    <header class="adminHeader">
        <div class="adminHeaderInner">
            <div class="adminBrand">
                <img src="/img/logo.png" class="adminBrandLogo" alt="ADR лого">
                <span class="adminBrandName">ADR <span class="adminBrandSub">Администрация</span></span>
            </div>
            <nav class="adminNav">
                <a href="/" class="adminNavLink">🔍 Сайт</a>
                <a href="/admin" class="adminNavLink">Табло</a>
                <a href="/admin/substances" class="adminNavLink">Вещества</a>
                <a href="/admin/instructions" class="adminNavLink">Инструкции</a>
                <a href="/admin/users" class="adminNavLink">Потребители</a>
                <a href="/admin/settings" class="adminNavLink">Настройки</a>
                <a href="/logout" class="adminNavLink adminNavLogout">Изход</a>
            </nav>
        </div>
    </header>

    <main class="adminMain">
        <%- body %>
    </main>

    <footer class="adminFooter">
        <p>&copy; 2026 Действие при инциденти с опасни товари &mdash; <a href="/legal">Правна информация</a></p>
    </footer>
</body>
</html>